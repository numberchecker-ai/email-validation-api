{
  "name": "Email Validation API",
  "brand": "NumberChecker",
  "repository": "numberchecker-ai/email-validation-api",
  "description": "Asynchronous bulk email validation API for NumberChecker.",
  "official_site": "https://numberchecker.ai",
  "landing_page": "https://numberchecker.ai/products/email-validation",
  "canonical_docs": "https://docs.numberchecker.ai/email-bulk-checker",
  "base_url": "https://api.numberchecker.ai",
  "auth": {
    "type": "api_key",
    "header": "X-API-Key"
  },
  "mode": "async",
  "endpoints": {
    "create_task": {
      "method": "POST",
      "path": "/v1/tasks"
    },
    "get_task": {
      "method": "POST",
      "path": "/v1/gettasks"
    },
    "balance": {
      "method": "GET",
      "path": "/v1/balance"
    }
  },
  "input": {
    "format": "text",
    "one_per_line": true,
    "input_kind": "email"
  },
  "products": [
    {
      "type": "email_check",
      "name": "Upload Task",
      "min": 2000,
      "max": 10000000,
      "fields": [
        "email",
        "activated"
      ]
    }
  ],
  "pricing_url": "https://numberchecker.ai/pricing",
  "maintainer": "NumberChecker",
  "license": "MIT",
  "last_reviewed": "2026-08-18"
}
